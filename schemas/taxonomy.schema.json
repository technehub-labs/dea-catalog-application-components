{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-catalog-information-system-components/schemas/taxonomy.schema.json",
  "title": "InformationSystemComponentTaxonomyRecord",
  "description": "JSON Schema for a taxonomy record in the Information System Component catalogue. CR-IS-CAT-02A (2026-10-18). Mirrors the YAML schema in taxonomy/component-domains.yaml, taxonomy/orthogonal-facets.yaml, and taxonomy/classification-rules.yaml.",
  "type": "object",
  "required": [
    "id",
    "code",
    "name",
    "type",
    "status",
    "version",
    "effective_date",
    "definition"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^iscc:(domain|category|subcategory|facet|rule):[a-z0-9-]+$",
      "description": "Stable taxonomy identifier in the iscc:<type>:<slug> namespace. The type prefix is one of domain, category, subcategory, facet, rule."
    },
    "code": {
      "type": "string",
      "pattern": "^(ISCC-[0-9]{2}|[0-9]\\.[0-9]|rule-[0-9]{2})$",
      "description": "Human-readable code: ISCC-NN for domains, N.M for facets, rule-NN for rules."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "type": {
      "type": "string",
      "enum": ["domain", "category", "subcategory", "facet", "rule"]
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "active", "deprecated", "retired"]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string"
    },
    "inclusion_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exclusion_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "synonyms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parent": {
      "type": "string",
      "pattern": "^iscc:(domain|category|subcategory):[a-z0-9-]+$"
    },
    "values": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cardinality": {
      "type": "string",
      "enum": ["one", "many"]
    },
    "doctrine_reference": {
      "type": ["string", "null"]
    },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "date", "cr", "note"],
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "cr": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Rule 9: no self-ancestor for taxonomy records.",
      "if": { "required": ["parent"] },
      "properties": {
        "parent": { "not": { "const": { "$data": "1/id" } } }
      }
    }
  ]
}
